{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WarpgateSH",
  "version": "0.1.1",
  "identifier": "dev.warpgatesh.companion",
  "build": {
    "beforeDevCommand": "npm run prepare:sidecars && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WarpgateSH",
        "width": 480,
        "height": 720,
        "minWidth": 420,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": [
      "binaries/warpgatesh",
      "binaries/warpgatesh-agent"
    ],
    "category": "Utility",
    "shortDescription": "Keep Warpgate SSH targets synchronized.",
    "longDescription": "Optional desktop companion for the WarpgateSH command-line client.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true
    }
  }
}
